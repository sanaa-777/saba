<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="main-content">
  <div class="container">
    <nav class="breadcrumbs">
      <a href="/">الرئيسية</a>
      <span class="separator">/</span>
      <span class="current">#<%= tag.name %></span>
    </nav>
    <div class="content-grid">
      <div class="content-area">
        <section class="section-block">
          <div class="section-header">
            <h2>الوسم: #<%= tag.name %></h2>
            <span class="news-count"><%= pagination.total %> خبر</span>
          </div>
          <% if (news.length > 0) { %>
          <div class="news-list">
            <% news.forEach(item => { %>
              <article class="news-list-item">
                <% if (item.image) { %><div class="list-item-image"><a href="/news/<%= item.id %>"><img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy"></a></div><% } %>
                <div class="list-item-content">
                  <h3><a href="/news/<%= item.id %>"><%= item.title %></a></h3>
                  <p><%= item.summary %></p>
                  <div class="card-meta">
                    <span class="card-category"><%= item.category_name %></span>
                    <span class="card-date"><%= new Date(item.published_at).toLocaleDateString('ar-YE') %></span>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
          <% if (pagination.totalPages > 1) { %>
          <%
            const tCur = pagination.page, tTot = pagination.totalPages;
            function tRange(c, t) { const d=2,r=[],w=[]; r.push(1); for(let i=Math.max(2,c-d);i<=Math.min(t-1,c+d);i++) r.push(i); if(t>1) r.push(t); let p=0; for(const x of r){if(x-p>1) w.push('...'); w.push(x); p=x;} return w; }
            const tPages = tRange(tCur, tTot);
          %>
          <div class="pagination">
            <% if (tCur > 1) { %><a href="?page=<%= tCur - 1 %>" class="page-link prev-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>السابق</a><% } %>
            <% tPages.forEach(function(p) { %><% if (p === '...') { %><span class="page-dots">…</span><% } else { %><a href="?page=<%= p %>" class="page-link<%= p === tCur ? ' active' : '' %>"><%= p %></a><% } %><% }) %>
            <% if (tCur < tTot) { %><a href="?page=<%= tCur + 1 %>" class="page-link next-link">التالي<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></a><% } %>
          </div>
          <% } %>
          <% } else { %>
          <div class="no-results"><p>لا توجد أخبار بهذا الوسم</p></div>
          <% } %>
        </section>
      </div>
      <%- include('partials/sidebar') %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
