<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  function timeAgo(dateStr) {
    if (!dateStr) return '';
    const now = new Date();
    const date = new Date(dateStr);
    const diff = Math.floor((now - date) / 1000);
    if (diff < 60) return 'الآن';
    if (diff < 3600) return 'قبل ' + Math.floor(diff / 60) + ' دقيقة';
    if (diff < 86400) return 'قبل ' + Math.floor(diff / 3600) + ' ساعة';
    if (diff < 172800) return 'قبل يوم';
    if (diff < 604800) return 'قبل ' + Math.floor(diff / 86400) + ' أيام';
    return date.toLocaleDateString('ar-YE');
  }
%>

<main class="main-content">
  <div class="container">
    <nav class="breadcrumbs">
      <a href="/">الرئيسية</a>
      <span class="separator">/</span>
      <span class="current">البحث</span>
    </nav>

    <section class="page-hero">
      <span class="eyebrow">البحث المتقدم</span>
      <h1 class="page-title">مركز البحث في الأخبار</h1>
      <p>ابحث في العناوين والمحتوى والتصنيفات والتواريخ مع ترتيب نتائج واضح وتجربة قراءة سريعة.</p>
    </section>

    <div class="content-grid">
      <div class="content-area">
        <section class="section-block">
          <form class="search-form" action="/search" method="GET">
            <div class="form-row">
              <div class="form-group full-width">
                <label for="q">كلمة البحث</label>
                <input type="text" id="q" name="q" value="<%= query.q || '' %>" placeholder="ابحث في العناوين أو المحتوى أو الملخصات">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="category">التصنيف</label>
                <select id="category" name="category">
                  <option value="">جميع التصنيفات</option>
                  <% if (categories) { %>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.id %>" <%= query.category == cat.id ? 'selected' : '' %>><%= cat.name_ar %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="form-group">
                <label for="scope">نطاق البحث</label>
                <select id="scope" name="scope">
                  <option value="all" <%= query.scope === 'all' ? 'selected' : '' %>>العنوان والمحتوى</option>
                  <option value="title" <%= query.scope === 'title' ? 'selected' : '' %>>العنوان فقط</option>
                  <option value="content" <%= query.scope === 'content' ? 'selected' : '' %>>المحتوى فقط</option>
                </select>
              </div>
              <div class="form-group">
                <label for="sort">ترتيب النتائج</label>
                <select id="sort" name="sort">
                  <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>الأحدث أولاً</option>
                  <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>الأقدم أولاً</option>
                  <option value="views" <%= query.sort === 'views' ? 'selected' : '' %>>الأكثر مشاهدة</option>
                  <option value="title" <%= query.sort === 'title' ? 'selected' : '' %>>أبجدي</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="date_from">من تاريخ</label>
                <input type="date" id="date_from" name="date_from" value="<%= query.date_from || '' %>">
              </div>
              <div class="form-group">
                <label for="date_to">إلى تاريخ</label>
                <input type="date" id="date_to" name="date_to" value="<%= query.date_to || '' %>">
              </div>
            </div>
            <div class="form-row">
              <button type="submit" class="btn btn-primary">تنفيذ البحث</button>
              <a href="/search" class="btn btn-secondary">إعادة الضبط</a>
            </div>
          </form>

          <% if (query.q) { %>
            <div class="results-header">
              <h3>نتائج البحث عن: "<%= query.q %>"</h3>
              <span><%= pagination.total %> نتيجة</span>
            </div>

            <% if (results.length > 0) { %>
              <div class="news-list">
                <% results.forEach(item => { %>
                  <article class="news-list-item<%= !item.image ? ' no-image' : '' %>">
                    <% if (item.image) { %>
                    <div class="list-item-image">
                      <a href="/news/<%= item.id %>">
                        <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy">
                      </a>
                    </div>
                    <% } %>
                    <div class="list-item-content">
                      <span class="eyebrow"><%= item.category_name || 'عام' %></span>
                      <h3><a href="/news/<%= item.id %>"><%= cleanEmoji(item.title) %></a></h3>
                      <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                      <div class="card-meta">
                        <span><%= timeAgo(item.published_at) %></span>

                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>

              <% if (pagination.totalPages > 1) { %>
              <%
                const sCur = pagination.page, sTot = pagination.totalPages;
                const sBase = '?q=' + encodeURIComponent(query.q || '') + '&category=' + (query.category || '') + '&scope=' + (query.scope || '') + '&sort=' + (query.sort || '') + '&date_from=' + (query.date_from || '') + '&date_to=' + (query.date_to || '') + '&';
                function sRange(c, t) { const d=2,r=[],w=[]; r.push(1); for(let i=Math.max(2,c-d);i<=Math.min(t-1,c+d);i++) r.push(i); if(t>1) r.push(t); let p=0; for(const x of r){if(x-p>1) w.push('...'); w.push(x); p=x;} return w; }
                const sPages = sRange(sCur, sTot);
              %>
              <div class="pagination">
                <% if (sCur > 1) { %><a href="<%= sBase %>page=<%= sCur - 1 %>" class="page-link prev-link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>السابق</a><% } %>
                <% sPages.forEach(function(p) { %><% if (p === '...') { %><span class="page-dots">…</span><% } else { %><a href="<%= sBase %>page=<%= p %>" class="page-link<%= p === sCur ? ' active' : '' %>"><%= p %></a><% } %><% }) %>
                <% if (sCur < sTot) { %><a href="<%= sBase %>page=<%= sCur + 1 %>" class="page-link next-link">التالي<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></a><% } %>
              </div>
              <% } %>
            <% } else { %>
              <div class="no-results"><p>لم يتم العثور على نتائج مطابقة. جرّب كلمات أخرى أو وسّع نطاق البحث.</p></div>
            <% } %>
          <% } %>
        </section>
      </div>

      <%- include('partials/sidebar') %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
