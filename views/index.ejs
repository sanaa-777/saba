<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  function timeAgo(dateStr) {
    if (!dateStr) return '';
    const now = new Date();
    const date = new Date(dateStr);
    const diff = Math.floor((now - date) / 1000);
    if (diff < 60) return 'الآن';
    if (diff < 3600) return 'قبل ' + Math.floor(diff / 60) + ' د';
    if (diff < 86400) return 'قبل ' + Math.floor(diff / 3600) + ' س';
    if (diff < 172800) return 'أمس';
    if (diff < 604800) return 'قبل ' + Math.floor(diff / 86400) + ' أيام';
    return new Date(dateStr).toLocaleDateString('ar-YE');
  }
  function articleLink(item) {
    const id = item.news_id || item.id;
    const slug = item.slug || (item.news_title || item.title || '').replace(/[^a-zA-Z0-9\u0600-\u06FF]+/g, '-').substring(0, 80);
    return '/news/' + id + '-' + slug;
  }
  function articleTitle(item) { return item.news_title || item.title; }
  function truncate(str, len) { if (!str) return ''; return str.length > len ? str.substring(0, len) + '...' : str; }
%>

<main class="home-page">
  <div class="container">

    <%/* ═══ HERO SECTION: Featured + Grid ═══ */%>
    <% const heroItems = sliderItems && sliderItems.length ? sliderItems : []; %>
    <% if (heroItems.length > 0) { %>
    <section class="hero-section" aria-label="أهم الأخبار">
      <%/* Main Featured Story */%>
      <article class="hero-main">
        <a href="<%= articleLink(heroItems[0]) %>">
          <% if (heroItems[0].image) { %>
          <div class="hero-main-img">
            <img src="<%= proxyImg(heroItems[0].image) %>" alt="<%= articleTitle(heroItems[0]) %>" decoding="async">
            <div class="hero-main-overlay"></div>
          </div>
          <% } %>
          <div class="hero-main-content">
            <span class="cat-badge"><%= heroItems[0].category_name || 'عاجل' %></span>
            <h1><%= articleTitle(heroItems[0]) %></h1>
            <% if (heroItems[0].summary) { %><p><%= truncate(heroItems[0].summary, 150) %></p><% } %>
            <span class="time-ago"><%= timeAgo(heroItems[0].published_at) %></span>
          </div>
        </a>
      </article>

      <%/* Side Stories Grid */%>
      <% if (heroItems.length > 1) { %>
      <div class="hero-side">
        <% heroItems.slice(1, 5).forEach(item => { %>
        <article class="hero-side-card">
          <a href="<%= articleLink(item) %>">
            <% if (item.image) { %>
            <div class="hero-side-img">
              <img src="<%= proxyImg(item.image) %>" alt="<%= articleTitle(item) %>" loading="lazy" decoding="async">
            </div>
            <% } %>
            <div class="hero-side-content">
              <span class="cat-badge-sm"><%= item.category_name || '' %></span>
              <h3><%= truncate(articleTitle(item), 80) %></h3>
              <span class="time-ago"><%= timeAgo(item.published_at) %></span>
            </div>
          </a>
        </article>
        <% }) %>
      </div>
      <% } %>
    </section>
    <% } %>

    <%/* ═══ BREAKING NEWS TICKER ═══ */%>
    <% if (urgentNews && urgentNews.length > 0) { %>
    <section class="breaking-strip" aria-label="أخبار عاجلة">
      <div class="breaking-label"><span class="pulse-dot"></span> عاجل</div>
      <div class="breaking-scroll">
        <% urgentNews.slice(0, 6).forEach(item => { %>
        <a href="/news/<%= item.id %>" class="breaking-item"><%= truncate(item.title, 100) %></a>
        <% }) %>
      </div>
    </section>
    <% } %>

    <%/* ═══ MAIN CONTENT + SIDEBAR LAYOUT ═══ */%>
    <div class="main-layout">

      <%/* ═══ MAIN CONTENT ═══ */%>
      <div class="main-content">

        <%/* ── LATEST NEWS GRID ── */%>
        <% if (latestGrid && latestGrid.length > 0) { %>
        <section class="section-block" aria-label="آخر الأخبار">
          <div class="section-title">
            <h2>آخر الأخبار</h2>
            <div class="title-line"></div>
          </div>
          <div class="news-grid-4">
            <% latestGrid.forEach(item => { %>
            <article class="news-card">
              <a href="/news/<%= item.id %>">
                <% if (item.image) { %>
                <div class="news-card-img">
                  <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy" decoding="async">
                </div>
                <% } %>
                <div class="news-card-body">
                  <span class="cat-badge-sm"><%= item.category_name || '' %></span>
                  <h4><%= truncate(item.title, 90) %></h4>
                  <span class="time-ago"><%= timeAgo(item.published_at) %></span>
                </div>
              </a>
            </article>
            <% }) %>
          </div>
        </section>
        <% } %>

        <%/* ── FEATURED NEWS ── */%>
        <% if (featuredNews && featuredNews.length > 0) { %>
        <section class="section-block" aria-label="مختارات">
          <div class="section-title">
            <h2>مختارات التحرير</h2>
            <div class="title-line"></div>
          </div>
          <div class="featured-grid">
            <% featuredNews.forEach(item => { %>
            <article class="featured-card">
              <a href="/news/<%= item.id %>">
                <% if (item.image) { %>
                <div class="featured-card-img">
                  <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy" decoding="async">
                </div>
                <% } %>
                <div class="featured-card-body">
                  <h3><%= truncate(item.title, 100) %></h3>
                  <% if (item.summary) { %><p><%= truncate(item.summary, 120) %></p><% } %>
                  <span class="time-ago"><%= timeAgo(item.published_at) %></span>
                </div>
              </a>
            </article>
            <% }) %>
          </div>
        </section>
        <% } %>

        <%/* ── CATEGORY SECTIONS ── */%>
        <% if (categories && categoryNews) { %>
          <% categories.forEach((cat, catIdx) => { %>
            <% const items = categoryNews[cat.id] || []; %>
            <% if (items.length > 0) { %>
            <section class="section-block cat-section" aria-label="<%= cat.name_ar %>">
              <div class="section-title">
                <h2><a href="/category/<%= cat.id %>"><%= cat.name_ar %></a></h2>
                <a href="/category/<%= cat.id %>" class="see-all">المزيد ←</a>
              </div>
              <div class="cat-layout">
                <%/* Lead article */%>
                <article class="cat-lead">
                  <a href="/news/<%= items[0].id %>">
                    <% if (items[0].image) { %>
                    <div class="cat-lead-img">
                      <img src="<%= proxyImg(items[0].image) %>" alt="<%= items[0].title %>" loading="lazy" decoding="async">
                    </div>
                    <% } %>
                    <div class="cat-lead-body">
                      <h3><%= items[0].title %></h3>
                      <% if (items[0].summary) { %><p><%= truncate(items[0].summary, 150) %></p><% } %>
                      <span class="time-ago"><%= timeAgo(items[0].published_at) %></span>
                    </div>
                  </a>
                </article>
                <%/* Side list */%>
                <% if (items.length > 1) { %>
                <div class="cat-list">
                  <% items.slice(1, 6).forEach(item => { %>
                  <article class="cat-list-item">
                    <% if (item.image) { %>
                    <a href="/news/<%= item.id %>" class="cat-list-img">
                      <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy" decoding="async">
                    </a>
                    <% } %>
                    <div class="cat-list-body">
                      <h4><a href="/news/<%= item.id %>"><%= truncate(item.title, 80) %></a></h4>
                      <span class="time-ago"><%= timeAgo(item.published_at) %></span>
                    </div>
                  </article>
                  <% }) %>
                </div>
                <% } %>
              </div>
            </section>
            <% } %>
          <% }) %>
        <% } %>

        <%/* ── AD BREAK ── */%>
        <% if (contentAds && contentAds.length > 0) { const ad = contentAds[0]; %>
        <section class="ad-block">
          <% if (ad.code) { %>
            <div class="ad-inner"><%- ad.code %></div>
          <% } else { %>
            <a class="ad-inner" href="<%= ad.link || '#' %>" <%= ad.link ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
              <% if (ad.image) { %><img src="<%= ad.image %>" alt="<%= ad.name %>" loading="lazy"><% } %>
            </a>
          <% } %>
        </section>
        <% } %>

      </div>

      <%/* ═══ SIDEBAR ═══ */%>
      <aside class="sidebar">

        <%/* ── LIVE UPDATES ── */%>
        <% if (latestNews && latestNews.length > 0) { %>
        <div class="sidebar-box live-feed">
          <div class="sidebar-title">
            <span class="pulse-dot"></span>
            <h3>غرفة الأخبار</h3>
          </div>
          <div class="live-list">
            <% latestNews.slice(0, 10).forEach((item, i) => { %>
            <article class="live-item">
              <span class="live-num"><%= i + 1 %></span>
              <div class="live-item-body">
                <h4><a href="/news/<%= item.id %>"><%= truncate(item.title, 80) %></a></h4>
                <span class="time-ago"><%= timeAgo(item.published_at) %></span>
              </div>
            </article>
            <% }) %>
          </div>
        </div>
        <% } %>

        <%/* ── MOST READ ── */%>
        <% if (mostRead && mostRead.length > 0) { %>
        <div class="sidebar-box most-read">
          <div class="sidebar-title">
            <h3>الأكثر قراءة</h3>
          </div>
          <div class="most-read-list">
            <% mostRead.forEach((item, i) => { %>
            <article class="most-read-item">
              <span class="rank rank-<%= i + 1 %>"><%= i + 1 %></span>
              <div class="most-read-body">
                <h4><a href="/news/<%= item.id %>"><%= truncate(item.title, 70) %></a></h4>
                <span class="views-count"><%= item.views %> مشاهدة</span>
              </div>
            </article>
            <% }) %>
          </div>
        </div>
        <% } %>

        <%/* ── BREAKING NEWS SIDEBAR ── */%>
        <% if (urgentNews && urgentNews.length > 0) { %>
        <div class="sidebar-box breaking-sidebar">
          <div class="sidebar-title urgent-title">
            <h3>⚡ أخبار عاجلة</h3>
          </div>
          <div class="breaking-list">
            <% urgentNews.slice(0, 5).forEach(item => { %>
            <article class="breaking-sidebar-item">
              <a href="/news/<%= item.id %>">
                <h4><%= truncate(item.title, 80) %></h4>
                <span class="time-ago"><%= timeAgo(item.published_at) %></span>
              </a>
            </article>
            <% }) %>
          </div>
        </div>
        <% } %>

        <%/* ── SIDEBAR AD ── */%>
        <% if (sidebarAds && sidebarAds.length > 0) { const ad = sidebarAds[0]; %>
        <div class="sidebar-box ad-box">
          <% if (ad.code) { %>
            <div class="ad-inner"><%- ad.code %></div>
          <% } else { %>
            <a class="ad-inner" href="<%= ad.link || '#' %>" <%= ad.link ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
              <% if (ad.image) { %><img src="<%= ad.image %>" alt="<%= ad.name %>" loading="lazy"><% } %>
            </a>
          <% } %>
        </div>
        <% } %>

        <%/* ── NEWSLETTER ── */%>
        <div class="sidebar-box newsletter-box">
          <h3>📬 النشرة البريدية</h3>
          <p>احصل على آخر الأخبار مباشرة في بريدك</p>
          <form action="/api/newsletter/subscribe" method="POST" class="newsletter-form">
            <input type="email" name="email" placeholder="بريدك الإلكتروني" required>
            <button type="submit">اشتراك</button>
          </form>
        </div>

      </aside>
    </div>

    <%/* ═══ MEDIA SECTION ═══ */%>
    <% if ((videos && videos.length) || (galleries && galleries.length)) { %>
    <section class="section-block media-section" aria-label="وسائط">
      <div class="section-title">
        <h2>وسائط</h2>
        <div class="title-line"></div>
      </div>
      <div class="media-grid">
        <% (videos || []).slice(0, 3).forEach(item => { %>
        <article class="media-card" onclick="openVideoModal('<%= item.file_path %>', '<%= item.title %>')">
          <div class="media-card-img">
            <img src="<%= proxyImg(item.thumbnail || item.file_path) %>" alt="<%= item.title %>" loading="lazy" decoding="async">
            <span class="play-icon">▶</span>
          </div>
          <div class="media-card-body">
            <span class="cat-badge-sm">فيديو</span>
            <h4><%= truncate(item.title, 60) %></h4>
          </div>
        </article>
        <% }) %>
        <% (galleries || []).slice(0, 2).forEach(item => { %>
        <article class="media-card">
          <a href="/gallery/<%= item.id %>">
            <div class="media-card-img">
              <img src="<%= proxyImg(item.thumbnail || item.file_path) %>" alt="<%= item.title %>" loading="lazy" decoding="async">
            </div>
            <div class="media-card-body">
              <span class="cat-badge-sm">صور</span>
              <h4><%= truncate(item.title, 60) %></h4>
            </div>
          </a>
        </article>
        <% }) %>
      </div>
    </section>
    <% } %>

    <%/* ═══ FOOTER AD ═══ */%>
    <% if (footerAds && footerAds.length > 0) { const ad = footerAds[0]; %>
    <section class="ad-block footer-ad">
      <% if (ad.code) { %>
        <div class="ad-inner"><%- ad.code %></div>
      <% } else { %>
        <a class="ad-inner" href="<%= ad.link || '#' %>" <%= ad.link ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <% if (ad.image) { %><img src="<%= ad.image %>" alt="<%= ad.name %>" loading="lazy"><% } %>
        </a>
      <% } %>
    </section>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
