<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  function timeAgo(dateStr) {
    if (!dateStr) return '';
    const now = new Date();
    const date = new Date(dateStr);
    const diff = Math.floor((now - date) / 1000);
    if (diff < 60) return 'الآن';
    if (diff < 3600) return 'قبل ' + Math.floor(diff / 60) + ' دقيقة';
    if (diff < 86400) return 'قبل ' + Math.floor(diff / 3600) + ' ساعة';
    if (diff < 172800) return 'قبل يوم';
    if (diff < 604800) return 'قبل ' + Math.floor(diff / 86400) + ' أيام';
    return date.toLocaleDateString('ar-YE');
  }
%>

<main class="main-content">
  <div class="container">
    <nav class="breadcrumbs">
      <a href="/">الرئيسية</a>
      <span class="separator">/</span>
      <span class="current"><%= category.name_ar %></span>
    </nav>

    <section class="page-hero">
      <span class="eyebrow"><%= category.name_ar %></span>
      <h1 class="page-title">تغطية <%= category.name_ar %></h1>
      <p>صفحة تصنيف منظّمة بعرض تحريري واضح، مع إبراز القصة الأهم ثم قائمة الأخبار الداعمة والأرشيف الكامل.</p>
    </section>

    <div class="content-grid">
      <div class="content-area">
        <% if (news.length > 0) { %>
          <section class="section-block">
            <div class="section-header">
              <div>
                <h2>ملف اليوم</h2>
                <p><%= pagination.total %> خبر ضمن هذا التصنيف.</p>
              </div>
              <span class="news-count">الصفحة <%= pagination.page %> من <%= pagination.totalPages || 1 %></span>
            </div>

            <div class="featured-listing">
              <article class="lead-card<%= !news[0].image ? ' no-image' : '' %>">
                <% if (news[0].image) { %>
                <a class="lead-card-media" href="/news/<%= news[0].id %>">
                  <img src="<%= proxyImg(news[0].image) %>" alt="<%= news[0].title %>">
                </a>
                <% } %>
                <div class="lead-card-body">
                  <span class="eyebrow"><%= category.name_ar %></span>
                  <h2><a href="/news/<%= news[0].id %>"><%= news[0].title %></a></h2>
                  <% if (news[0].summary) { %><p><%= news[0].summary %></p><% } %>
                  <div class="story-meta">
                    <span><%= new Date(news[0].published_at).toLocaleDateString('ar-YE') %></span>
                    <span><%= news[0].views %> مشاهدة</span>
                    <span><%= news[0].source || settings.site_name || 'أوتر نيوز' %></span>
                  </div>
                </div>
              </article>

              <div class="compact-stack">
                <% news.slice(1, 5).forEach(item => { %>
                  <article class="story-card-horizontal<%= !item.image ? ' no-image' : '' %>">
                    <% if (item.image) { %>
                    <a class="story-card-media" href="/news/<%= item.id %>-<%= (item.slug || item.title || "").replace(/\s+/g, "-").substring(0, 80).toLowerCase() %>">
                      <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy">
                    </a>
                    <% } %>
                    <div class="story-card-body">
                      <span class="eyebrow"><%= item.category_name || category.name_ar %></span>
                      <h3><a href="/news/<%= item.id %>-<%= (item.slug || item.title || "").replace(/\s+/g, "-").substring(0, 80).toLowerCase() %>"><%= item.title %></a></h3>
                      <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                      <div class="story-meta">
                        <span><%= timeAgo(item.published_at) %></span>
                        <span><%= item.views %> مشاهدة</span>
                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          </section>

          <section class="section-block">
            <div class="section-header">
              <div>
                <h2>كل الأخبار</h2>
                <p>قائمة كاملة قابلة للتصفح مع ترتيب زمني واضح.</p>
              </div>
            </div>

            <div class="news-list">
              <% news.forEach(item => { %>
                <article class="news-list-item<%= !item.image ? ' no-image' : '' %>">
                  <% if (item.image) { %>
                  <div class="list-item-image">
                    <a href="/news/<%= item.id %>-<%= (item.slug || item.title || "").replace(/\s+/g, "-").substring(0, 80).toLowerCase() %>">
                      <img src="<%= proxyImg(item.image) %>" alt="<%= item.title %>" loading="lazy">
                    </a>
                  </div>
                  <% } %>
                  <div class="list-item-content">
                    <span class="eyebrow"><%= item.category_name || category.name_ar %></span>
                    <h3><a href="/news/<%= item.id %>-<%= (item.slug || item.title || "").replace(/\s+/g, "-").substring(0, 80).toLowerCase() %>"><%= item.title %></a></h3>
                    <% if (item.summary) { %><p><%= item.summary %></p><% } %>
                    <div class="card-meta">
                      <span><%= timeAgo(item.published_at) %></span>
                      <span><%= item.views %> مشاهدة</span>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>

            <% if (pagination.totalPages > 1) { %>
            <%
              const current = pagination.page;
              const totalPages = pagination.totalPages;
              function getPageRange(cur, tot) {
                const delta = 2, range = [], withDots = [];
                range.push(1);
                for (let i = Math.max(2, cur - delta); i <= Math.min(tot - 1, cur + delta); i++) range.push(i);
                if (tot > 1) range.push(tot);
                let prev = 0;
                for (const p of range) { if (p - prev > 1) withDots.push('...'); withDots.push(p); prev = p; }
                return withDots;
              }
              const pages = getPageRange(current, totalPages);
            %>
            <div class="pagination">
              <% if (current > 1) { %>
                <a href="?page=<%= current - 1 %>" class="page-link prev-link">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                  السابق
                </a>
              <% } %>
              <% pages.forEach(function(p) { %>
                <% if (p === '...') { %>
                  <span class="page-dots">…</span>
                <% } else { %>
                  <a href="?page=<%= p %>" class="page-link<%= p === current ? ' active' : '' %>"><%= p %></a>
                <% } %>
              <% }) %>
              <% if (current < totalPages) { %>
                <a href="?page=<%= current + 1 %>" class="page-link next-link">
                  التالي
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
              <% } %>
            </div>
            <% } %>
          </section>
        <% } else { %>
          <div class="no-results"><p>لا توجد أخبار في هذا التصنيف حالياً.</p></div>
        <% } %>
      </div>

      <%- include('partials/sidebar') %>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
