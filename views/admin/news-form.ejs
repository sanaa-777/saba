<%- include('header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h3><%= article ? 'تعديل خبر' : 'إضافة خبر جديد' %></h3>
      <p class="admin-card-subtitle">واجهة تحرير مصقولة تحافظ على الوظائف الحالية وتسهّل إدخال البيانات.</p>
    </div>
    <a href="/admin/news" class="btn btn-secondary">العودة</a>
  </div>
  <div class="admin-card-body">
    <div id="statusMsg" class="status-msg"></div>
    <form id="newsForm" method="POST" action="<%= article ? '/api/v1/admin/news/edit/' + article.id : '/api/v1/admin/news/create' %>" enctype="multipart/form-data">
      <div class="form-row">
        <div class="form-group">
          <label>العنوان *</label>
          <input type="text" name="title" value="<%= article ? article.title : '' %>" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>الملخص</label>
          <textarea name="summary" rows="3"><%= article ? article.summary : '' %></textarea>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>المحتوى *</label>
          <textarea name="content" rows="14" required><%= article ? article.content : '' %></textarea>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>التصنيف</label>
          <select name="category_id">
            <option value="">اختر التصنيف</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= article && article.category_id == cat.id ? 'selected' : '' %>><%= cat.name_ar %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>المصدر</label>
          <input type="text" name="source" value="<%= article ? article.source || '' : 'أوتر نيوز' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>الصورة الرئيسية</label>
          <input type="file" name="image" accept="image/*,video/*,audio/*" id="imageInput" onchange="previewNewsImage(this)">
          <div id="imagePreviewBox" style="display:none;margin-top:10px;text-align:center;">
            <img id="newImagePreview" style="max-width:250px;max-height:160px;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.1);" src="">
            <p id="imageFileName" style="margin:6px 0 0;font-size:.82rem;color:#64748b;"></p>
          </div>
          <% if (article && article.image) { %>
            <div class="current-media-preview" style="margin-top:10px;"><img src="<%= article.image %>" id="currentImage" alt="الصورة الحالية" style="max-width:250px;border-radius:10px;"></div>
            <label class="form-check"><input type="checkbox" name="keep_image" value="1" checked id="keepImage"> الاحتفاظ بالصورة الحالية</label>
          <% } %>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>الوسوم</label>
          <div class="tag-selection-grid">
            <% tags.forEach(tag => { %>
              <label class="form-check tag-check">
                <input type="checkbox" name="tags" value="<%= tag.id %>" <%= article && articleTags && articleTags.includes(tag.id) ? 'checked' : '' %>>
                <span><%= tag.name %></span>
              </label>
            <% }); %>
          </div>
        </div>
      </div>
      <div class="form-row feature-flags">
        <div class="form-group"><label class="form-check"><input type="checkbox" name="is_breaking" value="1" <%= article && article.is_breaking ? 'checked' : '' %>> خبر عاجل</label></div>
        <div class="form-group"><label class="form-check"><input type="checkbox" name="is_slider" value="1" <%= article && article.is_slider ? 'checked' : '' %>> إظهار في السلايدر</label></div>
        <div class="form-group"><label class="form-check"><input type="checkbox" name="is_featured" value="1" <%= article && article.is_featured ? 'checked' : '' %>> خبر مميز</label></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>الحالة</label>
          <select name="status">
            <option value="1" <%= article && article.status === 1 ? 'selected' : '' %>>منشور</option>
            <option value="0" <%= article && article.status === 0 ? 'selected' : '' %>>مسودة</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>عنوان SEO</label>
          <input type="text" name="meta_title" value="<%= article ? article.meta_title || '' : '' %>">
        </div>
        <div class="form-group">
          <label>وصف SEO</label>
          <input type="text" name="meta_description" value="<%= article ? article.meta_description || '' : '' %>">
        </div>
      </div>
      <!-- Upload Progress -->
      <div id="uploadProgress" style="display:none;margin:16px 0;">
        <div style="background:#e2e8f0;border-radius:20px;overflow:hidden;height:8px;">
          <div id="uploadProgressFill" style="background:linear-gradient(90deg,#0f3b82,#1d4ed8);height:100%;width:0%;transition:width .3s;"></div>
        </div>
        <p id="uploadProgressText" style="text-align:center;margin:6px 0 0;font-size:.82rem;color:#64748b;">0%</p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submitBtn"><span id="btnText"><%= article ? 'حفظ التعديلات' : 'نشر الخبر' %></span><span id="btnSpinner" style="display:none"><span class="spinner"></span> جاري الحفظ...</span></button>
        <a href="/admin/news" class="btn btn-secondary">إلغاء</a>
      </div>
    </form>
  </div>
</div>

<script>
async function parseServerResponse(response) {
  const contentType = response.headers.get('content-type') || '';
  if (contentType.includes('application/json')) {
    return response.json();
  }
  const text = await response.text();
  return {
    success: false,
    message: text && text.trim() ? text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim() : 'استجاب الخادم بصيغة غير متوقعة'
  };
}

function previewNewsImage(input) {
  var file = input.files[0];
  if (!file) return;
  var box = document.getElementById('imagePreviewBox');
  var img = document.getElementById('newImagePreview');
  var fname = document.getElementById('imageFileName');
  fname.textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(1) + ' MB)';
  if (file.type.startsWith('image')) {
    var reader = new FileReader();
    reader.onload = function(e) { img.src = e.target.result; img.style.display = 'inline-block'; box.style.display = 'block'; };
    reader.readAsDataURL(file);
  } else {
    img.style.display = 'none';
    box.style.display = 'block';
  }
  // Uncheck keep_image when new file selected
  var keep = document.getElementById('keepImage');
  if (keep) keep.checked = false;
}

document.getElementById('newsForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('submitBtn');
  var btnText = document.getElementById('btnText');
  var btnSpinner = document.getElementById('btnSpinner');
  var statusMsg = document.getElementById('statusMsg');
  var progressBar = document.getElementById('uploadProgress');
  var progressFill = document.getElementById('uploadProgressFill');
  var progressText = document.getElementById('uploadProgressText');

  btn.disabled = true;
  btnText.style.display = 'none';
  btnSpinner.style.display = 'inline-flex';
  statusMsg.style.display = 'none';

  var formData = new FormData(this);
  var xhr = new XMLHttpRequest();
  xhr.open('POST', this.action);
  xhr.setRequestHeader('Accept', 'application/json');

  // Show progress if file attached
  var fileInput = document.getElementById('imageInput');
  if (fileInput.files.length) {
    progressBar.style.display = 'block';
    xhr.upload.onprogress = function(ev) {
      if (ev.lengthComputable) {
        var pct = Math.round((ev.loaded / ev.total) * 100);
        progressFill.style.width = pct + '%';
        progressText.textContent = pct + '%';
      }
    };
  }

  xhr.onload = function() {
    var result;
    try { result = JSON.parse(xhr.responseText); } catch(ex) { result = { success: false, message: 'استجابة غير متوقعة' }; }
    if (xhr.status === 200 && result.success) {
      statusMsg.className = 'status-msg success';
      statusMsg.textContent = result.message || 'تم الحفظ بنجاح';
      statusMsg.style.display = 'flex';
      if (!this.action || !this.action.includes('/edit/')) {
        setTimeout(function() { window.location.href = '/admin/news'; }, 1200);
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    } else {
      statusMsg.className = 'status-msg error';
      statusMsg.textContent = result.message || 'حدث خطأ أثناء حفظ الخبر';
      statusMsg.style.display = 'flex';
    }
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnSpinner.style.display = 'none';
    progressBar.style.display = 'none';
  }.bind(this);

  xhr.onerror = function() {
    statusMsg.className = 'status-msg error';
    statusMsg.textContent = 'تعذر الاتصال بالخادم';
    statusMsg.style.display = 'flex';
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnSpinner.style.display = 'none';
    progressBar.style.display = 'none';
  };

  xhr.send(formData);
});
</script>

<%- include('footer') %>
