<%- include('header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>إدارة الوسائط</h3>
    <button class="btn btn-primary" onclick="document.getElementById('uploadSection').style.display='block'">+ رفع ملف</button>
  </div>
  <div class="admin-card-body">
    <div id="uploadSection" style="display:none;margin-bottom:20px;padding:20px;background:#f8fafc;border-radius:12px;border:2px dashed #cbd5e1;">
      <form id="mediaUploadForm" method="POST" action="/admin/media/upload" enctype="multipart/form-data">
        <div class="upload-area" onclick="this.querySelector('input').click()" style="cursor:pointer;padding:30px;text-align:center;margin-bottom:16px;background:#fff;border-radius:8px;border:1px dashed #94a3b8;">
          <p style="font-size:48px;margin:0;">📁</p>
          <p style="margin:8px 0 0;color:#64748b;">اضغط لاختيار ملف أو اسحب الملف هنا</p>
          <p id="fileName" style="margin:8px 0 0;color:#0f3b82;font-weight:600;"></p>
          <input type="file" name="file" style="display:none;" accept="image/*,video/*,audio/*" required onchange="document.getElementById('fileName').textContent=this.files[0]?.name||''">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px;">
          <div class="form-group"><label style="display:block;margin-bottom:4px;font-weight:600;">العنوان</label><input type="text" name="title" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;"></div>
          <div class="form-group"><label style="display:block;margin-bottom:4px;font-weight:600;">النوع</label>
            <select name="type" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;"><option value="image">صورة</option><option value="video">فيديو</option><option value="audio">صوت</option></select>
          </div>
          <div class="form-group"><label style="display:block;margin-bottom:4px;font-weight:600;">التصنيف</label><input type="text" name="category" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;"></div>
        </div>
        <div class="form-group" style="margin-bottom:16px;"><label style="display:block;margin-bottom:4px;font-weight:600;">الوصف</label><textarea name="description" rows="2" style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;"></textarea></div>
        <div style="display:flex;gap:10px;">
          <button type="submit" class="btn btn-primary">رفع</button>
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('uploadSection').style.display='none'">إلغاء</button>
        </div>
      </form>
      <div id="uploadStatus" style="display:none;margin-top:12px;padding:10px;border-radius:8px;"></div>
    </div>

    <div class="filters-bar" style="margin-bottom:16px;display:flex;gap:8px;">
      <a href="/admin/media" class="btn btn-sm <%= !filterType ? 'btn-primary' : 'btn-secondary' %>">الكل</a>
      <a href="/admin/media?type=image" class="btn btn-sm <%= filterType === 'image' ? 'btn-primary' : 'btn-secondary' %>">صور</a>
      <a href="/admin/media?type=video" class="btn btn-sm <%= filterType === 'video' ? 'btn-primary' : 'btn-secondary' %>">فيديو</a>
      <a href="/admin/media?type=audio" class="btn btn-sm <%= filterType === 'audio' ? 'btn-primary' : 'btn-secondary' %>">صوت</a>
    </div>

    <% if (media.length > 0) { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
      <% media.forEach(item => { %>
      <div class="media-item" id="media-<%= item.id %>" style="border-radius:12px;overflow:hidden;background:#fff;border:1px solid #e2e8f0;position:relative;">
        <% if (item.type === 'image') { %>
          <img src="<%= item.file_path %>" alt="<%= item.title %>" style="width:100%;height:140px;object-fit:cover;" loading="lazy">
        <% } else if (item.type === 'video') { %>
          <div style="height:140px;background:linear-gradient(135deg,#1e293b,#334155);display:flex;align-items:center;justify-content:center;color:#fff;font-size:40px;">🎬</div>
        <% } else { %>
          <div style="height:140px;background:linear-gradient(135deg,#1e3a5f,#2d5a87);display:flex;align-items:center;justify-content:center;font-size:40px;">🎵</div>
        <% } %>
        <div style="padding:12px;">
          <p style="font-size:.85rem;font-weight:600;margin:0 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="<%= item.title %>"><%= item.title %></p>
          <p style="font-size:.75rem;color:#94a3b8;margin:0 0 8px;"><%= item.type %> • <%= item.category || 'عام' %></p>
          <button onclick="deleteMedia(<%= item.id %>)" class="btn btn-sm btn-danger" style="width:100%;">حذف</button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:60px 20px;color:#94a3b8;">
      <p style="font-size:48px;margin:0;">📂</p>
      <p style="margin:12px 0 0;">لا توجد ملفات مرفوعة</p>
    </div>
    <% } %>
  </div>
</div>

<script>
// Upload form with progress
document.getElementById('mediaUploadForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var form = this;
  var formData = new FormData(form);
  var status = document.getElementById('uploadStatus');
  var btn = form.querySelector('button[type="submit"]');

  btn.disabled = true;
  btn.textContent = 'جاري الرفع...';
  status.style.display = 'block';
  status.style.background = '#e2e8f0';
  status.textContent = 'جاري رفع الملف...';

  fetch('/admin/media/upload', {
    method: 'POST',
    body: formData
  }).then(function(r) {
    if (r.ok) {
      status.style.background = '#dcfce7';
      status.textContent = '✅ تم الرفع بنجاح!';
      setTimeout(function() { location.reload(); }, 800);
    } else {
      return r.text().then(function(t) { throw new Error(t); });
    }
  }).catch(function(err) {
    status.style.background = '#fee2e2';
    status.textContent = '❌ خطأ في الرفع: ' + (err.message || 'حاول مرة أخرى');
  }).finally(function() {
    btn.disabled = false;
    btn.textContent = 'رفع';
  });
});

// Delete media with AJAX
function deleteMedia(id) {
  if (!confirm('هل أنت متأكد من حذف هذا الملف؟')) return;

  fetch('/admin/media/delete/' + id, {
    method: 'POST',
    headers: { 'Accept': 'application/json' }
  }).then(function(r) {
    if (r.ok) {
      var el = document.getElementById('media-' + id);
      if (el) {
        el.style.transition = 'all .3s';
        el.style.opacity = '0';
        el.style.transform = 'scale(.9)';
        setTimeout(function() { el.remove(); }, 300);
      }
    } else {
      alert('فشل الحذف');
    }
  }).catch(function() {
    alert('خطأ في الاتصال');
  });
}
</script>

<%- include('footer') %>
