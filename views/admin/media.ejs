<%- include('header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>إدارة الوسائط</h3>
    <button class="btn btn-primary" onclick="toggleUpload()">+ رفع ملف</button>
  </div>
  <div class="admin-card-body">

    <!-- Upload Section -->
    <div id="uploadSection" style="display:none;margin-bottom:24px;padding:24px;background:#f8fafc;border-radius:16px;border:2px dashed #cbd5e1;">
      <form id="mediaForm" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- Drop Zone -->
        <div id="dropZone" style="cursor:pointer;padding:40px 20px;text-align:center;background:#fff;border-radius:12px;border:2px dashed #94a3b8;margin-bottom:16px;transition:all .2s;" onclick="document.getElementById('fileInput').click()">
          <div id="uploadIcon" style="font-size:48px;">📁</div>
          <p style="margin:8px 0 0;color:#64748b;font-size:.95rem;" id="dropText">اضغط لاختيار ملف أو اسحب الملف هنا</p>
          <p id="fileName" style="margin:8px 0 0;color:#0f3b82;font-weight:700;font-size:.9rem;"></p>
          <input type="file" name="file" id="fileInput" style="display:none;" accept="image/*,video/*,audio/*" onchange="handleFileSelect(this)">
        </div>

        <!-- Preview -->
        <div id="previewArea" style="display:none;margin-bottom:16px;text-align:center;">
          <img id="previewImage" style="max-width:300px;max-height:200px;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.1);" src="">
          <video id="previewVideo" style="max-width:300px;max-height:200px;border-radius:12px;box-shadow:0 4px 12px rgba(0,0,0,.1);" controls></video>
          <audio id="previewAudio" style="width:300px;margin-top:10px;" controls></audio>
        </div>

        <!-- Progress Bar -->
        <div id="progressBar" style="display:none;margin-bottom:16px;">
          <div style="background:#e2e8f0;border-radius:20px;overflow:hidden;height:10px;">
            <div id="progressFill" style="background:linear-gradient(90deg,#0f3b82,#1d4ed8);height:100%;width:0%;transition:width .3s;border-radius:20px;"></div>
          </div>
          <p id="progressText" style="text-align:center;margin:8px 0 0;font-size:.85rem;color:#64748b;">0%</p>
        </div>

        <!-- Fields -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">العنوان *</label>
            <input type="text" name="title" id="mediaTitle" required style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;font-size:.9rem;" placeholder="أدخل عنوان الملف">
          </div>
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">النوع</label>
            <select name="type" id="mediaType" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;font-size:.9rem;">
              <option value="image">صورة</option>
              <option value="video">فيديو</option>
              <option value="audio">صوت</option>
            </select>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">التصنيف</label>
            <input type="text" name="category" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;font-size:.9rem;" placeholder="عام">
          </div>
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">رابط اختياري</label>
            <input type="url" name="link" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;font-size:.9rem;" placeholder="https://example.com">
          </div>
        </div>

        <div style="margin-bottom:16px;">
          <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">الوصف</label>
          <textarea name="description" rows="2" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;font-size:.9rem;" placeholder="وصف اختياري للملف"></textarea>
        </div>

        <!-- Buttons -->
        <div style="display:flex;gap:10px;">
          <button type="submit" id="uploadBtn" class="btn btn-primary" style="padding:10px 28px;">رفع الملف</button>
          <button type="button" class="btn btn-secondary" onclick="toggleUpload()" style="padding:10px 28px;">إلغاء</button>
        </div>

        <!-- Status -->
        <div id="uploadStatus" style="display:none;margin-top:14px;padding:12px 16px;border-radius:10px;font-size:.9rem;font-weight:600;"></div>
      </form>
    </div>

    <!-- Filters -->
    <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
      <a href="/admin/media" class="btn btn-sm <%= !filterType ? 'btn-primary' : 'btn-secondary' %>">الكل</a>
      <a href="/admin/media?type=image" class="btn btn-sm <%= filterType === 'image' ? 'btn-primary' : 'btn-secondary' %>">📷 صور</a>
      <a href="/admin/media?type=video" class="btn btn-sm <%= filterType === 'video' ? 'btn-primary' : 'btn-secondary' %>">🎬 فيديو</a>
      <a href="/admin/media?type=audio" class="btn btn-sm <%= filterType === 'audio' ? 'btn-primary' : 'btn-secondary' %>">🎵 صوت</a>
    </div>

    <!-- Media Grid -->
    <% if (media.length > 0) { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;">
      <% media.forEach(item => { %>
      <div id="media-<%= item.id %>" style="border-radius:14px;overflow:hidden;background:#fff;border:1px solid #e2e8f0;transition:all .3s;">
        <% if (item.type === 'image') { %>
          <% if (item.link) { %>
            <a href="<%= item.link %>" target="_blank" rel="noopener">
              <img src="<%= item.file_path %>" alt="<%= item.title %>" style="width:100%;height:150px;object-fit:cover;" loading="lazy" onerror="this.style.display='none'">
            </a>
          <% } else { %>
            <img src="<%= item.file_path %>" alt="<%= item.title %>" style="width:100%;height:150px;object-fit:cover;" loading="lazy" onerror="this.style.display='none'">
          <% } %>
        <% } else if (item.type === 'video') { %>
          <div style="height:150px;background:linear-gradient(135deg,#1e293b,#334155);display:flex;align-items:center;justify-content:center;"><span style="font-size:48px;">🎬</span></div>
        <% } else { %>
          <div style="height:150px;background:linear-gradient(135deg,#1e3a5f,#2d5a87);display:flex;align-items:center;justify-content:center;"><span style="font-size:48px;">🎵</span></div>
        <% } %>
        <div style="padding:14px;">
          <p style="font-size:.88rem;font-weight:700;margin:0 0 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="<%= item.title %>"><%= item.title || 'بدون عنوان' %></p>
          <p style="font-size:.75rem;color:#94a3b8;margin:0 0 4px;"><%= item.type %> • <%= item.category || 'عام' %></p>
          <% if (item.description) { %><p style="font-size:.75rem;color:#64748b;margin:0 0 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= item.description %></p><% } %>
          <% if (item.link) { %><p style="font-size:.7rem;margin:0 0 8px;"><a href="<%= item.link %>" target="_blank" rel="noopener" style="color:#0f3b82;">🔗 رابط</a></p><% } %>
          <button onclick="deleteMedia(<%= item.id %>)" style="width:100%;padding:8px;background:#fee2e2;color:#b91c1c;border:none;border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;">🗑 حذف</button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %>
    <div style="text-align:center;padding:80px 20px;color:#94a3b8;">
      <p style="font-size:64px;margin:0;">📂</p>
      <p style="margin:16px 0 0;font-size:1.1rem;">لا توجد ملفات مرفوعة</p>
      <p style="margin:4px 0 0;font-size:.85rem;">اضغط "رفع ملف" لبدء الرفع</p>
    </div>
    <% } %>
  </div>
</div>

<script>
function toggleUpload() {
  var s = document.getElementById('uploadSection');
  s.style.display = s.style.display === 'none' ? 'block' : 'none';
  if (s.style.display === 'none') resetForm();
}

function resetForm() {
  document.getElementById('mediaForm').reset();
  document.getElementById('fileName').textContent = '';
  document.getElementById('previewArea').style.display = 'none';
  document.getElementById('progressBar').style.display = 'none';
  document.getElementById('uploadStatus').style.display = 'none';
  document.getElementById('uploadIcon').textContent = '📁';
  document.getElementById('dropText').textContent = 'اضغط لاختيار ملف أو اسحب الملف هنا';
}

function handleFileSelect(input) {
  var file = input.files[0];
  if (!file) return;

  document.getElementById('fileName').textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(1) + ' MB)';
  document.getElementById('dropText').textContent = '✅ تم اختيار الملف';
  document.getElementById('uploadIcon').textContent = file.type.startsWith('video') ? '🎬' : file.type.startsWith('audio') ? '🎵' : '🖼️';

  // Auto-detect type
  if (file.type.startsWith('video')) document.getElementById('mediaType').value = 'video';
  else if (file.type.startsWith('audio')) document.getElementById('mediaType').value = 'audio';
  else document.getElementById('mediaType').value = 'image';

  // Preview
  var preview = document.getElementById('previewArea');
  var pImg = document.getElementById('previewImage');
  var pVid = document.getElementById('previewVideo');
  var pAud = document.getElementById('previewAudio');

  pImg.style.display = 'none';
  pVid.style.display = 'none';
  pAud.style.display = 'none';

  if (file.type.startsWith('image')) {
    var reader = new FileReader();
    reader.onload = function(e) { pImg.src = e.target.result; pImg.style.display = 'inline-block'; };
    reader.readAsDataURL(file);
    preview.style.display = 'block';
  } else if (file.type.startsWith('video')) {
    pVid.src = URL.createObjectURL(file);
    pVid.style.display = 'inline-block';
    preview.style.display = 'block';
  } else if (file.type.startsWith('audio')) {
    pAud.src = URL.createObjectURL(file);
    pAud.style.display = 'block';
    preview.style.display = 'block';
  }
}

// Drag & Drop
var dropZone = document.getElementById('dropZone');
dropZone.addEventListener('dragover', function(e) { e.preventDefault(); this.style.borderColor = '#0f3b82'; this.style.background = '#eff6ff'; });
dropZone.addEventListener('dragleave', function(e) { e.preventDefault(); this.style.borderColor = '#94a3b8'; this.style.background = '#fff'; });
dropZone.addEventListener('drop', function(e) {
  e.preventDefault();
  this.style.borderColor = '#94a3b8'; this.style.background = '#fff';
  var files = e.dataTransfer.files;
  if (files.length) {
    document.getElementById('fileInput').files = files;
    handleFileSelect(document.getElementById('fileInput'));
  }
});

// Upload with progress
document.getElementById('mediaForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var fileInput = document.getElementById('fileInput');
  if (!fileInput.files.length) {
    showStatus('❌ اختر ملف أولاً', 'error');
    return;
  }

  var title = document.getElementById('mediaTitle').value.trim();
  if (!title) {
    showStatus('❌ أدخل عنوان الملف', 'error');
    return;
  }

  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  formData.append('title', title);
  formData.append('type', document.getElementById('mediaType').value);
  formData.append('category', this.querySelector('[name="category"]').value);
  formData.append('description', this.querySelector('[name="description"]').value);
  formData.append('link', this.querySelector('[name="link"]').value);

  var btn = document.getElementById('uploadBtn');
  var progressBar = document.getElementById('progressBar');
  var progressFill = document.getElementById('progressFill');
  var progressText = document.getElementById('progressText');

  btn.disabled = true;
  btn.textContent = 'جاري الرفع...';
  progressBar.style.display = 'block';
  progressFill.style.width = '0%';
  showStatus('', 'clear');

  var xhr = new XMLHttpRequest();
  xhr.open('POST', '/admin/media/upload');
  xhr.setRequestHeader('Accept', 'application/json');
  xhr.setRequestHeader('X-CSRF-Token', document.querySelector('[name=_csrf]').value);

  xhr.upload.onprogress = function(ev) {
    if (ev.lengthComputable) {
      var pct = Math.round((ev.loaded / ev.total) * 100);
      progressFill.style.width = pct + '%';
      progressText.textContent = pct + '% — ' + (ev.loaded / 1024 / 1024).toFixed(1) + ' / ' + (ev.total / 1024 / 1024).toFixed(1) + ' MB';
    }
  };

  xhr.onload = function() {
    if (xhr.status === 200 || xhr.status === 302) {
      showStatus('✅ تم الرفع بنجاح!', 'success');
      setTimeout(function() { location.reload(); }, 1000);
    } else {
      var msg = 'خطأ في الرفع';
      try { var r = JSON.parse(xhr.responseText); msg = r.message || msg; } catch(ex) {}
      showStatus('❌ ' + msg, 'error');
    }
    btn.disabled = false;
    btn.textContent = 'رفع الملف';
  };

  xhr.onerror = function() {
    showStatus('❌ خطأ في الاتصال بالخادم', 'error');
    btn.disabled = false;
    btn.textContent = 'رفع الملف';
  };

  xhr.send(formData);
});

function showStatus(msg, type) {
  var s = document.getElementById('uploadStatus');
  if (type === 'clear') { s.style.display = 'none'; return; }
  s.style.display = 'block';
  s.textContent = msg;
  s.style.background = type === 'success' ? '#dcfce7' : '#fee2e2';
  s.style.color = type === 'success' ? '#15803d' : '#b91c1c';
}

// Delete media
function deleteMedia(id) {
  if (!confirm('هل أنت متأكد من حذف هذا الملف؟')) return;

  fetch('/admin/media/delete/' + id, {
    method: 'POST',
    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name=_csrf]').value }
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var el = document.getElementById('media-' + id);
      if (el) {
        el.style.transition = 'all .3s';
        el.style.opacity = '0';
        el.style.transform = 'scale(.8)';
        setTimeout(function() { el.remove(); }, 300);
      }
    } else {
      alert('فشل الحذف: ' + (data.message || 'خطأ غير معروف'));
    }
  }).catch(function() {
    alert('خطأ في الاتصال');
  });
}
</script>

<%- include('footer') %>
