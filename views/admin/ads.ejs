<%- include('header') %>

<div class="admin-card">
  <div class="admin-card-header">
    <h3>📢 إدارة الإعلانات</h3>
    <button class="btn btn-primary" onclick="toggleAdd()">+ إضافة إعلان</button>
  </div>
  <div class="admin-card-body">

    <!-- Status Message -->
    <div id="statusMsg" style="display:none;padding:12px 16px;border-radius:10px;margin-bottom:16px;font-weight:600;"></div>

    <!-- Add Form -->
    <div id="addSection" style="display:none;margin-bottom:24px;padding:24px;background:#f8fafc;border-radius:16px;border:2px dashed #cbd5e1;">
      <form id="addForm" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">اسم الإعلان *</label>
            <input type="text" name="name" required style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;" placeholder="مثال: إعلان سابر نيوز">
          </div>
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">الموضع *</label>
            <select name="position" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;">
              <option value="header">🔝 أعلى الصفحة</option>
              <option value="sidebar">📌 الشريط الجانبي</option>
              <option value="content">📄 داخل المحتوى</option>
              <option value="footer">🔻 أسفل الصفحة</option>
            </select>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">صورة الإعلان</label>
            <input type="file" name="image" accept="image/*" onchange="previewImg(this)" style="width:100%;padding:10px;border:1px solid #e2e8f0;border-radius:10px;">
            <div id="imgPreview" style="display:none;margin-top:8px;text-align:center;"><img id="previewImg" style="max-width:200px;border-radius:8px;" src=""></div>
          </div>
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">الرابط (عند النقر)</label>
            <input type="url" name="link" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;" placeholder="https://example.com">
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">تاريخ البداية</label>
            <input type="date" name="start_date" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;">
          </div>
          <div>
            <label style="display:block;margin-bottom:4px;font-weight:700;font-size:.85rem;">تاريخ النهاية</label>
            <input type="date" name="end_date" style="width:100%;padding:10px 14px;border:1px solid #e2e8f0;border-radius:10px;">
          </div>
        </div>

        <div style="margin-bottom:14px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" name="is_active" value="1" checked style="width:18px;height:18px;">
            <span style="font-weight:600;">مفعل</span>
          </label>
        </div>

        <div style="display:flex;gap:10px;">
          <button type="submit" id="addBtn" class="btn btn-primary" style="padding:10px 28px;">➕ إضافة إعلان</button>
          <button type="button" class="btn btn-secondary" onclick="toggleAdd()" style="padding:10px 28px;">إلغاء</button>
        </div>
      </form>
    </div>

    <!-- Ads List -->
    <% if (ads.length === 0) { %>
    <div style="text-align:center;padding:60px 20px;color:#94a3b8;">
      <p style="font-size:64px;margin:0;">📢</p>
      <p style="margin:16px 0 0;font-size:1.1rem;">لا توجد إعلانات</p>
      <p style="margin:4px 0 0;font-size:.85rem;">اضغط "إضافة إعلان" لإنشاء إعلان جديد</p>
    </div>
    <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
      <% ads.forEach(ad => { %>
      <div id="ad-<%= ad.id %>" style="border-radius:14px;overflow:hidden;background:#fff;border:1px solid #e2e8f0;">
        <div style="height:120px;background:linear-gradient(135deg,#f1f5f9,#e2e8f0);display:flex;align-items:center;justify-content:center;position:relative;">
          <% if (ad.image) { %>
            <img src="<%= ad.image.startsWith('data:') ? ad.image : '/api/proxy-image?url=' + encodeURIComponent(ad.image) %>" alt="<%= ad.name %>" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'">
          <% } else { %>
            <span style="font-size:48px;">📢</span>
          <% } %>
          <span style="position:absolute;top:8px;right:8px;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:700;background:<%= ad.position === 'header' ? '#dcfce7' : ad.position === 'sidebar' ? '#dbeafe' : ad.position === 'content' ? '#fef3c7' : '#f1f5f9' %>;color:<%= ad.position === 'header' ? '#15803d' : ad.position === 'sidebar' ? '#1d4ed8' : ad.position === 'content' ? '#b45309' : '#475569' %>;">
            <%= ad.position === 'header' ? 'أعلى' : ad.position === 'sidebar' ? 'جانبي' : ad.position === 'content' ? 'محتوى' : 'أسفل' %>
          </span>
        </div>
        <div style="padding:14px;">
          <p style="font-size:.95rem;font-weight:700;margin:0 0 4px;"><%= ad.name %></p>
          <% if (ad.link) { %><p style="font-size:.75rem;color:#3b82f6;margin:0 0 4px;">🔗 <%= ad.link.substring(0,40) %></p><% } %>
          <p style="font-size:.75rem;color:#94a3b8;margin:0 0 10px;">
            <% if (ad.start_date || ad.end_date) { %>
              <%= ad.start_date || '—' %> → <%= ad.end_date || '—' %>
            <% } else { %>دائماً<% } %>
            • <span style="color:<%= ad.is_active ? '#15803d' : '#b45309' %>"><%= ad.is_active ? 'مفعل' : 'معطل' %></span>
          </p>
          <button onclick="deleteAd(<%= ad.id %>)" style="width:100%;padding:8px;background:#fee2e2;color:#b91c1c;border:none;border-radius:8px;font-size:.82rem;font-weight:600;cursor:pointer;">🗑 حذف</button>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</div>

<script>
function toggleAdd() {
  var s = document.getElementById('addSection');
  s.style.display = s.style.display === 'none' ? 'block' : 'none';
}

function previewImg(input) {
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    document.getElementById('previewImg').src = e.target.result;
    document.getElementById('imgPreview').style.display = 'block';
  };
  reader.readAsDataURL(file);
}

function showStatus(msg, type) {
  var s = document.getElementById('statusMsg');
  s.style.display = 'block';
  s.textContent = msg;
  s.style.background = type === 'success' ? '#dcfce7' : '#fee2e2';
  s.style.color = type === 'success' ? '#15803d' : '#b91c1c';
  setTimeout(function() { s.style.display = 'none'; }, 5000);
}

// Create ad with AJAX
document.getElementById('addForm').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('addBtn');
  btn.disabled = true;
  btn.textContent = 'جاري الإضافة...';

  var formData = new FormData(this);

  fetch('/admin/ads/create', {
    method: 'POST',
    body: formData,
    headers: { 'Accept': 'application/json' }
  }).then(function(r) {
    if (r.ok) {
      showStatus('✅ تم إضافة الإعلان بنجاح!', 'success');
      setTimeout(function() { location.reload(); }, 1000);
    } else {
      return r.text().then(function(t) {
        try { var j = JSON.parse(t); throw new Error(j.message || j.error || 'خطأ'); } catch(ex) { throw new Error(t.substring(0, 100)); }
      });
    }
  }).catch(function(err) {
    showStatus('❌ خطأ: ' + err.message, 'error');
  }).finally(function() {
    btn.disabled = false;
    btn.textContent = '➕ إضافة إعلان';
  });
});

// Delete ad with AJAX
function deleteAd(id) {
  if (!confirm('هل أنت متأكد من حذف هذا الإعلان؟')) return;

  fetch('/admin/ads/delete/' + id, {
    method: 'POST',
    headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' }
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var el = document.getElementById('ad-' + id);
      if (el) {
        el.style.transition = 'all .3s';
        el.style.opacity = '0';
        setTimeout(function() { el.remove(); }, 300);
      }
      showStatus('✅ تم حذف الإعلان', 'success');
    } else {
      showStatus('❌ فشل الحذف: ' + (data.message || ''), 'error');
    }
  }).catch(function() {
    showStatus('❌ خطأ في الاتصال', 'error');
  });
}
</script>

<%- include('footer') %>
